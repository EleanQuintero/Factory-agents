# ============================================
# VARIABLES GLOBALES (inyectadas al crear VM)
# ============================================

# DATABASE (Supabase remoto)
PG_HOST=your-project.supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=your-password-here

# PROVIDER DE IA (global, misma para todos los tenants)
ANTHROPIC_API_KEY=sk-ant-...

# COMPOSIO (global)
COMPOSIO_API_KEY=your-composio-key

# TAVILY (global)
TAVILY_API_KEY=your-tavily-key

# RESEND (global, para emails)
RESEND_API_KEY=re_...

# MODELOS (configuración global de Mastra)
DEFAULT_MODEL=anthropic/claude-sonnet-4-5
HAIKU_MODEL=anthropic/claude-haiku-4-5-20251001